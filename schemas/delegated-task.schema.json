{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DelegatedTask",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "requested_by",
    "objective",
    "context_refs",
    "allowed_tools",
    "denied_tools",
    "risk_level",
    "requires_confirmation",
    "max_runtime_seconds",
    "output_format",
    "audit_required"
  ],
  "properties": {
    "task_id": { "type": "string", "minLength": 1 },
    "requested_by": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "context_refs": { "type": "array", "items": { "type": "string" } },
    "allowed_tools": { "type": "array", "items": { "type": "string" } },
    "denied_tools": { "type": "array", "items": { "type": "string" } },
    "risk_level": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "requires_confirmation": { "type": "boolean" },
    "max_runtime_seconds": { "type": "integer", "minimum": 1 },
    "output_format": { "type": "string", "minLength": 1 },
    "audit_required": { "type": "boolean" },
    "protocol_version": { "type": "string", "enum": ["1.0", "2.0", "3.0-draft"] },
    "delegation_id": { "type": "string", "minLength": 1 },
    "attempt_id": { "type": "string", "minLength": 1 },
    "contract_fingerprint": { "type": "string", "minLength": 1 },
    "project": { "type": "string", "minLength": 1 },
    "topic_id": { "type": "string", "minLength": 1 },
    "task_type": { "type": "string", "minLength": 1 },
    "executor_backend": { "type": "string", "enum": ["hermes", "codex", "openclaw"] },
    "executor_profile": { "type": "string", "minLength": 1 },
    "backend_agent_id": { "type": "string", "minLength": 1 },
    "approval_grant_id": { "type": "string", "minLength": 1 },
    "external_effect_budget": { "type": "integer", "minimum": 0 },
    "workspace_policy": { "type": "string", "enum": ["dedicated", "shared-readonly"] },
    "session_policy": { "type": "string", "enum": ["ephemeral", "persistent"] },
    "credential_refs": { "type": "array", "items": { "type": "string" } },
    "idempotency_key": { "type": "string", "minLength": 1 },
    "openclaw_task_id": { "type": "string", "minLength": 1 },
    "target_url": { "type": "string", "format": "uri", "minLength": 1 },
    "start_idempotency_key": { "type": "string", "minLength": 1 },
    "backend_run_id": { "type": "string", "minLength": 1 },
    "backend_session_key": { "type": "string", "minLength": 1 },
    "dry_run": { "type": "boolean" },
    "scope": { "type": "object" },
    "context_packet": { "type": "object" },
    "confirmation_policy": { "type": "object" },
    "result_contract": { "type": "object" },
    "loop_contract": { "type": "object" },
    "message_path": { "type": "object" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "protocol_version": { "const": "2.0" } },
        "required": ["protocol_version"]
      },
      "then": {
        "required": [
          "delegation_id",
          "attempt_id",
          "contract_fingerprint",
          "project",
          "topic_id",
          "executor_backend",
          "executor_profile",
          "backend_agent_id",
          "external_effect_budget",
          "workspace_policy",
          "session_policy",
          "credential_refs",
          "idempotency_key",
          "dry_run"
        ]
      }
    },
    {
      "if": {
        "properties": { "protocol_version": { "const": "3.0-draft" } },
        "required": ["protocol_version"]
      },
      "then": {
        "required": [
          "delegation_id",
          "attempt_id",
          "contract_fingerprint",
          "project",
          "topic_id",
          "task_type",
          "executor_backend",
          "executor_profile",
          "backend_agent_id",
          "external_effect_budget",
          "workspace_policy",
          "session_policy",
          "credential_refs",
          "idempotency_key",
          "dry_run",
          "scope",
          "context_packet",
          "confirmation_policy",
          "result_contract"
        ]
      }
    }
  ]
}
